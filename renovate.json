{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main",
    "business"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "automerge": false,
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home\\/nvim\\/nvim-pack-lock\\.json$/"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}",
      "matchStrings": [
        "\"(?<depName>[^\"]+)\":\\s*\\{\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"src\":\\s*\"https://github\\.com/(?<packageName>[^\"]+)\"\\s*\\}"
      ],
      "currentValueTemplate": "main",
      "depTypeTemplate": "vim-pack-default"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home\\/nvim\\/nvim-pack-lock\\.json$/"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}",
      "matchStrings": [
        "\"(?<depName>[^\"]+)\":\\s*\\{\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"src\":\\s*\"https://github\\.com/(?<packageName>(?:neovim/nvim-lspconfig|vim-jp/vimdoc-ja))\"\\s*\\}"
      ],
      "currentValueTemplate": "master",
      "depTypeTemplate": "vim-pack-master"
    }
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": [
        "vim-pack-default"
      ],
      "matchPackageNames": [
        "https://github.com/neovim/nvim-lspconfig",
        "https://github.com/vim-jp/vimdoc-ja"
      ],
      "enabled": false
    }
  ]
}
