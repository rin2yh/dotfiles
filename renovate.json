{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Automerge mise CLI patch updates after a timestamped seven-day release age",
      "matchManagers": ["mise"],
      "matchDepTypes": ["tools"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "ignoreTests": false,
      "internalChecksAsSuccess": false,
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    }
  ],
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^home\\/nvim\\/nvim-pack-lock\\.json$/"
      ],
      "matchStrings": [
        "$each(plugins, function($v, $k) { { \"depName\": $k, \"packageName\": $substringAfter($v.src, \"https://github.com/\"), \"currentValue\": ($substringAfter($v.src, \"https://github.com/\") = \"neovim/nvim-lspconfig\" or $substringAfter($v.src, \"https://github.com/\") = \"vim-jp/vimdoc-ja\") ? \"master\" : \"main\", \"currentDigest\": $v.rev, \"datasource\": \"github-digest\", \"versioning\": \"exact\" } })"
      ]
    }
  ],
  "nix": {
    "enabled": true
  },
  "baseBranchPatterns": [
    "main",
    "for-business"
  ]
}
