{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/gopher.txt",
    "type": "file",
    "color": {
      // Go brand cyan: rgb(0,173,216)
      "1": "38;2;0;173;216"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "modules": [
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "break"
  ]
}
