{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    // Renée French's Go gopher (https://github.com/golang-samples/gopher-vector, CC BY 3.0)
    "source": "~/.config/fastfetch/gopher.png",
    "type": "kitty",
    "width": 30,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "modules": [
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "break"
  ]
}
